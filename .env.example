# AREA 51 local environment — template. Copy to `.env` (gitignored) and fill in.
# Single source of truth for all deploy-time variables and secrets.
# `scripts/render-wrangler.sh <worker|agent>` reads this file and renders the
# per-worker wrangler.toml from its .template. Deploy scripts source this
# file too, so anything wrangler/curl needs at deploy time comes from here.

# --- Cloudflare account ---
# API token: Cloudflare → My Profile → API Tokens → "Edit Cloudflare Workers"
# template. Zone-level permissions are NOT required — DNS / Custom Domain
# mapping for workers + the Pages project is configured manually in the
# Cloudflare dashboard, not by the deploy scripts.
CLOUDFLARE_API_TOKEN=
# Account ID: Cloudflare → Workers & Pages → any project → right sidebar.
CLOUDFLARE_ACCOUNT_ID=

# --- D1 database (shared by all workers + Pages Functions) ---
# Created with: `wrangler d1 create area51`
D1_DATABASE_NAME=area51
D1_DATABASE_ID=

# --- Black Holes worker ---
# The worker that catches incoming HTTP requests and emails on whichever
# Black Hole domains have been bound to it via the Cloudflare dashboard
# (DNS / Custom Domain mapping is intentionally manual).
WORKER_NAME=area51-worker
# Forward-target inbox: last-resort destination for the original email only
# when the email handler errors (R2 PUT throws, parse/handler exception).
# Routine emails are stored in full to R2, not forwarded.
FALLBACK_ADDRESS=

# --- R2 bucket (raw .eml storage, shared by worker + agent + Pages) ---
# Every captured email's raw .eml is stored here at key emails/<id>.eml.
# Create it manually once R2 is enabled on the account:
#   wrangler r2 bucket create area51-emails
# Bound as "EML" on the worker + agent worker via their templates; the Pages
# binding is added in the dashboard (Pages -> area51 -> Settings -> Functions).
R2_BUCKET_NAME=area51-emails

# --- AREA 51 dashboard (Cloudflare Pages) ---
PAGES_PROJECT_NAME=area51
# JSON list of {domain, roles} black holes (roles ⊆ ["http","mail"]). The LIVE
# source of truth is now the D1 `domains` table — read by the dashboard's
# /api/config/domains (Home orbit chips) AND by the Autopilot worker (so an
# agent can build full callback URLs). This value is only the SEED used to
# populate that table at deploy. To change domains after deploy, edit D1:
#   wrangler d1 execute area51 --command "INSERT OR REPLACE INTO domains ..." --remote
DOMAINS_CONFIG=[{"domain":"example.com","roles":["http","mail"]}]

# --- Autopilot worker ---
# The MCP server (with a REST mirror) that authorized Claude Code / Codex
# agents talk to during pentests. Serves /requests, /emails, /autopilot/*,
# and /mcp. Bound to a Custom Domain manually via the Cloudflare dashboard.
# Bearer-style auth on every call.
AGENT_WORKER_NAME=agent-a51-worker
# Shared secret sent by clients in the X-A51-Secret header. Same value is
# installed on the worker via `wrangler secret put AGENT_SECRET` (encrypted
# in Cloudflare's vault). Generate with: openssl rand -hex 32
AGENT_SECRET=
