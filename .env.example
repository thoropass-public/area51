# AREA 51 configuration — template. Copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#   ./a51 setup
#
# `.env` is the single source of truth for every deploy-time value. `./a51 setup`
# writes back into this file as it discovers or provisions things (account id,
# database id, hostnames, generated secret), so after a successful setup your
# `.env` describes the whole deployment. Everything below is documented in
# docs/configuration.md.
#
# Only ONE value is truly required to start: CLOUDFLARE_API_TOKEN. Setup prompts
# for anything else it needs and fills in the rest.

# ─── Cloudflare credentials ──────────────────────────────────────────────────

# API token. Create at: Cloudflare dashboard → My Profile → API Tokens →
# Create Token → Custom token. Required permissions (see docs/setup.md#api-token):
#   Account · Workers Scripts:Edit          Account · Workers R2 Storage:Edit
#   Account · D1:Edit                       Account · Cloudflare Pages:Edit
#   Account · Account Settings:Read         Account · Access: Apps and Policies:Edit
#   Account · Access: Organizations, Identity Providers, and Groups:Edit
#   Account · Email Routing Addresses:Edit
#   Zone    · Zone:Read                     Zone · DNS:Edit
#   Zone    · Workers Routes:Edit           Zone · Email Routing Rules:Edit
# Zone permissions must include the zone you are deploying onto.
CLOUDFLARE_API_TOKEN=

# Account ID. Left blank, setup discovers it (and asks if the token can see
# more than one account), then writes it back here.
CLOUDFLARE_ACCOUNT_ID=

# ─── Hostnames ───────────────────────────────────────────────────────────────
# The zone (a domain already added to this Cloudflare account) that setup
# provisions on, plus the three hostnames it maps. Leave blank and setup will
# list your zones and prompt, defaulting to the layout shown here.
CLOUDFLARE_ZONE=

# Dashboard (Cloudflare Pages + Cloudflare Access). Humans only.
DASHBOARD_HOSTNAME=

# Autopilot — the MCP / REST server AI agents connect to. Secret-authenticated.
AUTOPILOT_HOSTNAME=

# Black hole — the catch-all host targets are pointed at. Public by necessity.
# Defaults to the zone apex. Additional black holes can be added later with
# `./a51 domains add <host> http,mail`.
BLACK_HOLE_HOSTNAME=

# Roles for the black hole above: comma-separated subset of http,mail.
# `mail` enables Cloudflare Email Routing on the zone with a catch-all that
# feeds every incoming message to the worker.
BLACK_HOLE_ROLES=http,mail

# ─── Cloudflare Access (dashboard authentication) ────────────────────────────
# The dashboard has NO authentication of its own — Access is what keeps it
# private. Setup creates a Zero Trust organization (if the account has none),
# enables the One-time PIN login method, and puts an Access application in
# front of DASHBOARD_HOSTNAME allowing only the identities below.
#
# Comma-separated allow-list. Entries are either full addresses
# (alice@example.com) or bare domains (example.com = anyone with that email
# domain). Setup refuses to continue with an empty list unless you pass
# `--no-access`, which leaves the dashboard world-readable.
ALLOWED_EMAILS=

# Zero Trust team name — the <team>.cloudflareaccess.com subdomain used for the
# login screen. Only used when the account has no Zero Trust organization yet.
# Blank = derived from the zone name.
ACCESS_TEAM_NAME=

# How long an Access session lasts before re-authentication. Format: 30m, 24h, 730h.
ACCESS_SESSION_DURATION=24h

# ─── Storage ─────────────────────────────────────────────────────────────────
# D1 database, shared by all three workers and the dashboard's Pages Functions.
D1_DATABASE_NAME=area51
# Filled in by setup after the database is created.
D1_DATABASE_ID=

# R2 bucket for captured email. One verbatim .eml per captured message at
# emails/<id>.eml. Bound as EML.
R2_BUCKET_NAME=area51-emails

# R2 bucket for endpoint file uploads — one object per file-backed endpoint,
# keyed by a random UUID. Separate from the email bucket so uploads can be
# wiped or given their own lifecycle rules independently. Bound as FILES.
R2_FILES_BUCKET_NAME=area51-files

# ─── Worker + project names ──────────────────────────────────────────────────
# Cloudflare service names. Changing one after deploy creates a NEW worker and
# orphans the old one (along with its bound domains) — see docs/operations.md.
WORKER_NAME=area51-black-holes
AGENT_WORKER_NAME=area51-autopilot
CLEANUP_WORKER_NAME=area51-cleanup
PAGES_PROJECT_NAME=area51

# ─── Black Holes worker ──────────────────────────────────────────────────────
# Last-resort inbox. Used ONLY when email capture fails (R2 write throws, the
# handler errors); the original message is forwarded here instead of being lost.
# Successfully captured mail is never forwarded. Must be a verified Email
# Routing destination address on the account, or forwarding silently fails.
FALLBACK_ADDRESS=

# ─── Autopilot worker ────────────────────────────────────────────────────────
# Shared secret every agent sends as `X-A51-Secret`. Setup generates one if
# blank and installs it as an encrypted Worker Secret. Rotate with
# `./a51 rotate-secret`. Generate manually with: openssl rand -hex 32
AGENT_SECRET=

# ─── Cleanup worker (retention) ──────────────────────────────────────────────
# Number of most-recent `requests` rows to keep; older rows are deleted.
CLEANUP_REQUESTS_KEEP=1000
# Max age in days for captured emails. Rows AND their R2 .eml objects older
# than this are deleted. Starred emails are exempt and kept forever.
CLEANUP_EMAIL_MAX_AGE_DAYS=90
# Cron schedule (UTC), standard 5 fields: min hour dom mon dow. Must be quoted.
CLEANUP_CRON="0 6 * * *"
