# AREA 51 local environment — template. Copy to `.env` (gitignored) and fill in.
# Single source of truth for all deploy-time variables and secrets.
# `scripts/render-wrangler.sh <worker|agent>` reads this file and renders the
# per-worker wrangler.toml from its .template. Deploy scripts source this
# file too, so anything wrangler/curl needs at deploy time comes from here.

# --- Cloudflare account ---
# API token: Cloudflare → My Profile → API Tokens → "Edit Cloudflare Workers"
# template, with Zone Resources covering oob.example + ops.example so Custom
# Domain bindings can be set declaratively.
CLOUDFLARE_API_TOKEN=
# Account ID: Cloudflare → Workers & Pages → any project → right sidebar.
CLOUDFLARE_ACCOUNT_ID=

# --- D1 database (shared by all workers + Pages Functions) ---
# Created with: `wrangler d1 create area51`
D1_DATABASE_NAME=area51
D1_DATABASE_ID=

# --- Main exploit-server worker (oob.example) ---
WORKER_NAME=area51-worker
EXPLOIT_DOMAIN=oob.example
# Forward-target inbox: gets the original email when the worker's email handler
# falls back due to size > 1 MB, attachments present, or a D1 write failure.
FALLBACK_ADDRESS=

# --- Pages dashboard (area51.ops.example) ---
PAGES_PROJECT_NAME=area51
DASHBOARD_DOMAIN=area51.ops.example
# JSON list of {domain, roles} entries shown as orbit chips on the Home page.
# Each role string is one of: "http", "mail". Source of truth lives on
# Cloudflare as a Pages environment variable named DOMAINS_CONFIG (Pages →
# area51 → Settings → Variables and Secrets). To edit live: change the
# value there. To mirror locally for documentation/sync: set it here too.
DOMAINS_CONFIG=[{"domain":"example.com","roles":["http","mail"]}]

# --- Agent worker (agent-a51.ops.example) ---
# Read-only worker that serves /requests, /emails, and /mcp to Claude Code /
# Codex agents during authorized pentests. Bearer-style auth on every call.
AGENT_WORKER_NAME=agent-a51-worker
AGENT_DOMAIN=agent-a51.ops.example
# Shared secret sent by clients in the X-A51-Secret header. Same value is
# installed on the worker via `wrangler secret put AGENT_SECRET` (encrypted
# in Cloudflare's vault). Generate with: openssl rand -hex 32
AGENT_SECRET=
