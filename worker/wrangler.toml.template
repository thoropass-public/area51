# Template for worker/wrangler.toml — processed by scripts/render-wrangler.sh.
# Placeholders (in dollar-brace form) are substituted from the repo-root .env
# file. DO NOT edit worker/wrangler.toml directly — it's a generated artifact
# and will be overwritten on the next render. Edit this template or .env.

name = "${WORKER_NAME}"
main = "src/index.js"
compatibility_date = "2024-10-11"
compatibility_flags = ["nodejs_compat"]

# Suppress the auto-generated public URLs. The worker is only reachable
# through the Custom Domain(s) bound to it via the Cloudflare dashboard.
workers_dev = false
preview_urls = false

# Custom Domain mapping and zone-level Email Routing are configured
# manually in the Cloudflare dashboard (intentionally not automated):
#   Workers & Pages → black-hole worker → Settings → Domains & Routes
#   <zone> → Email → Email Routing → catch-all → Send to a Worker
# This keeps the deploy script free of zone-level permissions and lets
# the same worker accept any number of bound domains without redeploy.

# Persist Workers Logs so they're queryable via the Cloudflare dashboard.
[observability]
enabled = true

[[d1_databases]]
binding = "DB"
database_name = "${D1_DATABASE_NAME}"
database_id = "${D1_DATABASE_ID}"

[vars]
FALLBACK_ADDRESS = "${FALLBACK_ADDRESS}"
