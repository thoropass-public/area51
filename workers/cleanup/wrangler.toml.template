# Template for workers/cleanup/wrangler.toml.
#
# Dollar-brace placeholders are substituted from the repo-root .env every time you
# run `./a51 deploy cleanup`. DO NOT edit workers/cleanup/wrangler.toml
# directly. It is a generated, gitignored artifact and will be overwritten.

name = "${CLEANUP_WORKER_NAME}"
main = "src/index.js"
compatibility_date = "2026-05-20"

# No public surface at all: this worker has only a scheduled() handler and is
# never bound to a domain. The disabled URLs are belt-and-suspenders.
workers_dev = false
preview_urls = false

# Retention run schedule, in UTC. From CLEANUP_CRON in .env (default 06:00
# daily). Deploying registers the trigger; there is nothing else to click.
[triggers]
crons = ["${CLEANUP_CRON}"]

[observability]
enabled = true

# Same shared stores as the other two workers. This worker reads ids from D1,
# deletes the matching R2 .eml objects, then deletes the D1 rows.
[[d1_databases]]
binding = "DB"
database_name = "${D1_DATABASE_NAME}"
database_id = "${D1_DATABASE_ID}"

[[r2_buckets]]
binding = "EML"
bucket_name = "${R2_BUCKET_NAME}"

# Endpoint files. Held for one job: the monthly /-/ purge deletes an endpoint's
# object before the row that points at it, and without this binding that purge
# would have to skip every file-backed row and leave it behind forever.
#
# This does NOT loosen Autopilot's fence. Autopilot still has no FILES binding,
# which is what stops an agent reading, replacing or deleting a payload a human
# uploaded. This worker has no fetch handler and no domain: it cannot be asked
# for an object by anyone, it never reads the bucket, and it never writes to it.
[[r2_buckets]]
binding = "FILES"
bucket_name = "${R2_FILES_BUCKET_NAME}"

# Retention thresholds, tunable from .env without a code edit. Quoted so they
# arrive as strings; the worker parses them with a safe integer fallback.
[vars]
CLEANUP_REQUESTS_KEEP = "${CLEANUP_REQUESTS_KEEP}"
CLEANUP_EMAIL_MAX_AGE_DAYS = "${CLEANUP_EMAIL_MAX_AGE_DAYS}"
# off | daily | weekly | monthly, for the /-/ purge. Empty renders as empty and
# the worker falls back to monthly, so a deployment upgraded without this key in
# .env keeps the behavior it had rather than failing to render.
CLEANUP_AUTOPILOT_PURGE = "${CLEANUP_AUTOPILOT_PURGE}"
